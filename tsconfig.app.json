{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": []
  },
  "files": [
    "src/main.server.ts",  
    "src/server.ts",
    "src/main.ts"
  ],
  "include": [
    "src/**/*.server.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
